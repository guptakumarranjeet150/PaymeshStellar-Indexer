# --- Stellar / Soroban ---
# Soroban RPC endpoint to poll for contract events
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Network passphrase ("Test SDF Network ; September 2015" for testnet)
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Deployed AutoShare contract id to index (C...)
AUTOSHARE_CONTRACT_ID=
# Ledger to begin indexing from (0 = earliest the RPC retains)
START_LEDGER=0

# --- Ingestion ---
# Poll interval in milliseconds
POLL_INTERVAL_MS=5000
# Max events to request per getEvents page
EVENTS_PAGE_SIZE=100

# --- Database ---
DATABASE_URL=postgres://paymesh:paymesh@localhost:5432/paymesh_indexer

# --- API ---
API_PORT=4000
# Comma-separated list of allowed CORS origins
API_CORS_ORIGINS=http://localhost:3000

# --- Logging ---
# trace | debug | info | warn | error
LOG_LEVEL=info
